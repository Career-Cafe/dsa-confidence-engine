package templates

import (
	"fmt"
	"github.com/MishraShardendu22/dsa-confidence-engine/internal/dsa"
)

templ ProblemNew(concepts []*dsa.Concept) {
	@Layout("Create Problem") {
		<div class="card">
			<h2 class="card-header">Create New DSA Problem Definition</h2>
			<form id="problem-form" method="POST" action="/problems/create">
				<div class="grid-2">
					<div>
						<label for="prob-id">Problem ID</label>
						<input type="text" id="prob-id" name="id" placeholder="e.g. 3sum" required />
					</div>
					<div>
						<label for="prob-title">Title</label>
						<input type="text" id="prob-title" name="title" placeholder="e.g. 3Sum" required />
					</div>
				</div>

				<label for="prob-desc">Description</label>
				<textarea id="prob-desc" name="description" rows="3" placeholder="Problem prompt..." required></textarea>

				<div class="grid-2">
					<div>
						<label for="prob-lang">Language</label>
						<input type="text" id="prob-lang" name="language" value="python" required />
					</div>
					<div>
						<label for="prob-entrypoint">Entrypoint Function Name</label>
						<input type="text" id="prob-entrypoint" name="entrypoint" value="solve" required />
					</div>
				</div>

				<div class="grid-2">
					<div>
						<label for="required-concepts">Required Concepts (Loaded Dynamically from Ontology)</label>
						<select id="required-concepts" name="required_concepts" multiple style="height: 180px;">
							for _, c := range concepts {
								<option value={ c.ID }>{ fmt.Sprintf("%s (%s - %s)", c.Name, c.ID, c.Category) }</option>
							}
						</select>
						<span style="font-size: 0.75rem; color: #8b949e;">Hold Ctrl / Cmd to select multiple concepts</span>
					</div>

					<div>
						<label for="optional-concepts">Optional Concepts (Loaded Dynamically from Ontology)</label>
						<select id="optional-concepts" name="optional_concepts" multiple style="height: 180px;">
							for _, c := range concepts {
								<option value={ c.ID }>{ fmt.Sprintf("%s (%s - %s)", c.Name, c.ID, c.Category) }</option>
							}
						</select>
						<span style="font-size: 0.75rem; color: #8b949e;">Hold Ctrl / Cmd to select multiple concepts</span>
					</div>
				</div>

				<label for="accepted-strategies">Accepted Strategies (comma separated)</label>
				<input type="text" id="accepted-strategies" name="accepted_strategies" placeholder="e.g. two_pointers_opposite_end, hashmap_two_sum" />

				<label for="tests-json">Test Cases (JSON format)</label>
				<textarea id="tests-json" name="tests_json" class="code-editor" rows="6" required>
					{ `[{"id": "1", "input": "{\"nums\": [2, 7, 11, 15], \"target\": 9}", "expected_output": "[0, 1]"}]` }
				</textarea>

				<div style="display: flex; justify-content: flex-end; margin-top: 12px;">
					<button type="submit" class="btn">Create Problem Definition</button>
				</div>
			</form>
		</div>
	}
}
