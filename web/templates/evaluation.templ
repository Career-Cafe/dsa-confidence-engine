package templates

import (
	"fmt"
	"github.com/MishraShardendu22/dsa-confidence-engine/internal/model"
)

func testBorder(passed bool) string {
	if passed {
		return "1px solid rgba(35, 134, 54, 0.4)"
	}
	return "1px solid rgba(218, 54, 51, 0.6)"
}

func testBg(passed bool) string {
	if passed {
		return "rgba(35, 134, 54, 0.05)"
	}
	return "rgba(218, 54, 51, 0.08)"
}

func outputBorder(passed bool) string {
	if passed {
		return "1px solid rgba(35, 134, 54, 0.4)"
	}
	return "1px solid rgba(218, 54, 51, 0.5)"
}

func outputBg(passed bool) string {
	if passed {
		return "rgba(35, 134, 54, 0.08)"
	}
	return "rgba(218, 54, 51, 0.12)"
}

func outputColor(passed bool) string {
	if passed {
		return "#3fb950"
	}
	return "#f85149"
}

templ Evaluation(eval *model.Evaluation) {
	@Layout(fmt.Sprintf("Evaluation %s", eval.ID)) {
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
			<div>
				<h1 style="font-size: 1.4rem; color: #f0f6fc;">Evaluation Report</h1>
				<p style="font-size: 0.85rem; color: #8b949e;">ID: <code>{ eval.ID }</code> | Problem: <code>{ eval.ProblemID }</code> | Duration: { fmt.Sprintf("%dms", eval.DurationMs) }</p>
			</div>
			<div>
				if eval.Decision == model.DecisionAccept {
					<span class="badge badge-accept" style="font-size: 1.1rem; padding: 6px 16px;">ACCEPT</span>
				} else if eval.Decision == model.DecisionRejustify {
					<span class="badge badge-rejustify" style="font-size: 1.1rem; padding: 6px 16px;">REJUSTIFY</span>
				} else {
					<span class="badge badge-reject" style="font-size: 1.1rem; padding: 6px 16px;">REJECT</span>
				}
			</div>
		</div>

		<!-- Summary Grid -->
		<div class="grid-2">
			<!-- Test Results Card -->
			<div class="card">
				<h3 class="card-header">Test Execution Gate</h3>
				<div style="display: flex; align-items: center; gap: 16px; margin-bottom: 12px;">
					if eval.TestResult == model.TestStatusPass {
						<span class="badge badge-accept">PASS</span>
					} else {
						<span class="badge badge-reject">FAIL</span>
					}
					<span style="font-size: 0.95rem; color: #f0f6fc;">
						Passed: <strong>{ fmt.Sprintf("%d", eval.PassedTests) }</strong> / <strong>{ fmt.Sprintf("%d", eval.TotalTests) }</strong> test cases
					</span>
				</div>
				if eval.Reason != "" {
					<p style="font-size: 0.9rem; color: #8b949e;">{ eval.Reason }</p>
				}
			</div>

			<!-- Fidelity Score Card -->
			<div class="card">
				<h3 class="card-header">Fidelity Score</h3>
				<div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px;">
					<span style="font-size: 2.2rem; font-weight: 700; color: #f0f6fc;">
						{ fmt.Sprintf("%.1f%%", eval.FidelityScore * 100) }
					</span>
					<span style="font-size: 0.9rem; color: #8b949e;">
						(Thresholds: &lt;90% Reject, 90-95% Rejustify, &ge;95% Accept)
					</span>
				</div>
			</div>
		</div>

		<!-- Test Case Side-by-Side Execution & Output Comparison -->
		if len(eval.TestDetails) > 0 {
			<div class="card">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 8px;">
					<h3 style="font-size: 1.1rem; font-weight: 600; color: var(--text-bright); margin: 0;">
						Test Cases (Input &amp; Output Side-by-Side)
					</h3>
					<div>
						if eval.TestResult == model.TestStatusPass {
							<span class="badge badge-accept">ALL TEST CASES MATCH</span>
						} else {
							<span class="badge badge-reject">TEST DISCREPANCY DETECTED</span>
						}
					</div>
				</div>

				for idx, t := range eval.TestDetails {
					<div style={ fmt.Sprintf("margin-bottom: 20px; padding: 16px; border-radius: 8px; border: %s; background: %s;", testBorder(t.Passed), testBg(t.Passed)) }>
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
							<div style="display: flex; align-items: center; gap: 10px;">
								<span style="font-weight: 600; color: #f0f6fc; font-size: 0.95rem;">Test Case #{ fmt.Sprintf("%d", idx+1) } (ID: <code>{ t.ID }</code>)</span>
								if t.Passed {
									<span class="badge badge-accept">PASSED</span>
								} else {
									<span class="badge badge-reject">FAILED</span>
								}
							</div>
						</div>

						if !t.Passed {
							<!-- Failure Diagnostic Banner: Prominently identifies where code failed -->
							<div style="background: rgba(218, 54, 51, 0.2); border: 1px solid var(--danger); border-radius: 6px; padding: 10px 14px; margin-bottom: 14px;">
								<div style="font-weight: 700; color: var(--danger-text); font-size: 0.85rem; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
									<span>FAILED HERE:</span>
								</div>
								<div style="font-family: var(--font-mono); font-size: 0.85rem; color: #f0f6fc; white-space: pre-wrap; word-break: break-all;">
									if t.Error != "" {
										{ t.Error }
									} else {
										{ fmt.Sprintf("Output discrepancy: Expected '%s', but received '%s'", t.ExpectedOutput, t.ActualOutput) }
									}
								</div>
							</div>
						}

						<!-- Side-by-Side: Input on Left, Output Comparison on Right -->
						<div class="grid-2" style="gap: 16px;">
							<!-- LEFT: Input Arguments -->
							<div style="background: #0d1117; border: 1px solid #30363d; border-radius: 6px; padding: 12px;">
								<div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
									<span style="font-size: 0.8rem; font-weight: 600; color: #8b949e; text-transform: uppercase; letter-spacing: 0.5px;">Input (Arguments)</span>
									<span style="font-size: 0.75rem; color: #58a6ff; font-family: var(--font-mono);">test_case_{ t.ID }</span>
								</div>
								<pre style="margin: 0; font-family: var(--font-mono); font-size: 0.85rem; color: #f0f6fc; background: transparent; overflow-x: auto; white-space: pre-wrap; word-break: break-all;">
									<code>{ t.Input }</code>
								</pre>
							</div>

							<!-- RIGHT: Output Comparison (Expected vs Actual) -->
							<div style="background: #0d1117; border: 1px solid #30363d; border-radius: 6px; padding: 12px;">
								<div style="margin-bottom: 12px;">
									<div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
										<span style="font-size: 0.8rem; font-weight: 600; color: #8b949e; text-transform: uppercase; letter-spacing: 0.5px;">Expected Output</span>
										<span style="font-size: 0.75rem; color: var(--success-text);">Canonical Expected</span>
									</div>
									<pre style="margin: 0; padding: 8px; border-radius: 4px; border: 1px solid rgba(35, 134, 54, 0.4); background: rgba(35, 134, 54, 0.08); font-family: var(--font-mono); font-size: 0.85rem; color: #3fb950; overflow-x: auto; white-space: pre-wrap; word-break: break-all;">
										<code>{ t.ExpectedOutput }</code>
									</pre>
								</div>

								<div>
									<div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
										<span style="font-size: 0.8rem; font-weight: 600; color: #8b949e; text-transform: uppercase; letter-spacing: 0.5px;">Actual Output (Your Code)</span>
										if t.Passed {
											<span style="font-size: 0.75rem; color: var(--success-text); font-weight: 600;">Match</span>
										} else {
											<span style="font-size: 0.75rem; color: var(--danger-text); font-weight: 600;">Mismatch</span>
										}
									</div>
									<pre style={ fmt.Sprintf("margin: 0; padding: 8px; border-radius: 4px; border: %s; background: %s; font-family: var(--font-mono); font-size: 0.85rem; color: %s; overflow-x: auto; white-space: pre-wrap; word-break: break-all;", outputBorder(t.Passed), outputBg(t.Passed), outputColor(t.Passed)) }>
										<code>
											if t.ActualOutput != "" {
												{ t.ActualOutput }
											} else {
												<span style="font-style: italic; color: #8b949e;">[No output returned / Exception occurred]</span>
											}
										</code>
									</pre>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		}

		<!-- Diagnostics Card -->
		if len(eval.Diagnostics) > 0 {
			<div class="card" style="border-left: 4px solid var(--warning);">
				<h3 class="card-header" style="color: var(--warning);">Diagnostic Findings</h3>
				<ul style="padding-left: 20px; font-size: 0.9rem;">
					for _, d := range eval.Diagnostics {
						<li style="margin-bottom: 6px;">{ d }</li>
					}
				</ul>
			</div>
		}

		<!-- Concept Comparison Breakdown -->
		<div class="grid-2">
			<!-- Claimed Concepts (Point B) -->
			<div class="card">
				<h3 class="card-header">Point B: Claimed Concepts (Explanation)</h3>
				if len(eval.ClaimedConcepts) == 0 {
					if eval.TestResult == model.TestStatusFail {
						<p style="color: #8b949e; font-size: 0.85rem; font-style: italic;">Evaluation halted at Test Gate. Claimed concept extraction was skipped because candidate code failed required test cases.</p>
					} else {
						<p style="color: #8b949e; font-size: 0.9rem;">No DSA concepts detected in explanation.</p>
					}
				} else {
					<table>
						<thead>
							<tr>
								<th>Concept</th>
								<th>Stage</th>
								<th>Matched Phrase</th>
								<th>Confidence</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range eval.ClaimedConcepts {
								<tr>
									<td><strong>{ c.Name }</strong> <br/><code style="font-size: 0.75rem;">{ c.ConceptID }</code></td>
									<td><span class="badge badge-neutral">{ c.Stage }</span></td>
									<td style="font-style: italic;">"{ c.MatchedPhrase }"</td>
									<td>{ fmt.Sprintf("%.2f", c.Confidence) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>

			<!-- Detected Concepts (Point A) -->
			<div class="card">
				<h3 class="card-header">Point A: Detected Concepts (Code Analysis)</h3>
				if len(eval.ActualConcepts) == 0 {
					if eval.TestResult == model.TestStatusFail {
						<p style="color: #8b949e; font-size: 0.85rem; font-style: italic;">Evaluation halted at Test Gate. Static program analysis was skipped because candidate code failed required test cases.</p>
					} else {
						<p style="color: #8b949e; font-size: 0.9rem;">No DSA concepts detected in code.</p>
					}
				} else {
					<table>
						<thead>
							<tr>
								<th>Concept</th>
								<th>Reachable</th>
								<th>Output Relevant</th>
								<th>Confidence</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range eval.ActualConcepts {
								<tr>
									<td><strong>{ c.Name }</strong> <br/><code style="font-size: 0.75rem;">{ c.ConceptID }</code></td>
									<td>
										if c.Reachable {
											<span class="badge badge-accept">Yes</span>
										} else {
											<span class="badge badge-reject">No</span>
										}
									</td>
									<td>
										if c.OutputRelevant {
											<span class="badge badge-accept">Yes</span>
										} else {
											<span class="badge badge-rejustify">No</span>
										}
									</td>
									<td>{ fmt.Sprintf("%.2f", c.Confidence) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</div>

		<!-- Concrete Line Evidence Card -->
		if len(eval.Evidence) > 0 {
			<div class="card">
				<h3 class="card-header">Concrete Program Evidence</h3>
				<table>
					<thead>
						<tr>
							<th>Line</th>
							<th>Type</th>
							<th>Description</th>
							<th>Reachable</th>
							<th>Output Relevant</th>
						</tr>
					</thead>
					<tbody>
						for _, ev := range eval.Evidence {
							<tr>
								<td><code>{ fmt.Sprintf("line %d", ev.Line) }</code></td>
								<td><code>{ ev.Type }</code></td>
								<td>{ ev.Description }</td>
								<td>
									if ev.Reachable {
										<span class="badge badge-accept">Yes</span>
									} else {
										<span class="badge badge-reject">No</span>
									}
								</td>
								<td>
									if ev.OutputRelevant {
										<span class="badge badge-accept">Yes</span>
									} else {
										<span class="badge badge-neutral">No</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		<!-- Concept Match Status Tables -->
		<div class="card">
			<h3 class="card-header">Fidelity Synthesis</h3>
			<div class="grid-2">
				<div>
					<h4 style="font-size: 0.95rem; margin-bottom: 8px; color: var(--success-text);">Matched Concepts</h4>
					if len(eval.MatchedConcepts) == 0 {
						<p style="color: #8b949e; font-size: 0.85rem;">None</p>
					} else {
						<ul style="padding-left: 20px; font-size: 0.85rem;">
							for _, m := range eval.MatchedConcepts {
								<li style="margin-bottom: 4px;">
									<code>{ m.ConceptID }</code> - { m.Notes }
								</li>
							}
						</ul>
					}
				</div>

				<div>
					<h4 style="font-size: 0.95rem; margin-bottom: 8px; color: var(--danger-text);">Missing Claimed Concepts</h4>
					if len(eval.MissingConcepts) == 0 {
						<p style="color: #8b949e; font-size: 0.85rem;">None</p>
					} else {
						<ul style="padding-left: 20px; font-size: 0.85rem;">
							for _, m := range eval.MissingConcepts {
								<li style="margin-bottom: 4px;">
									<code>{ m.ConceptID }</code> - { m.Notes }
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</div>

		<!-- Candidate Input Reference -->
		<div class="card">
			<h3 class="card-header">Submission Reference</h3>
			<div style="margin-bottom: 16px;">
				<label>Candidate Explanation</label>
				<p style="background: #0d1117; padding: 12px; border-radius: 6px; border: 1px solid #30363d; font-size: 0.9rem;">
					{ eval.Explanation }
				</p>
			</div>
			<div>
				<label>Candidate Code</label>
				<pre style="background: #0d1117; padding: 12px; border-radius: 6px; border: 1px solid #30363d; font-family: var(--font-mono); font-size: 0.85rem; overflow-x: auto;">
					<code>{ eval.SubmissionCode }</code>
				</pre>
			</div>
		</div>
	}
}
