package templates

import (
	"fmt"
	"github.com/MishraShardendu22/dsa-confidence-engine/internal/model"
)

templ Index(problems []model.Problem) {
	@Layout("Evaluate Submission") {
		<div class="card">
			<h2 class="card-header">Submission Evaluator</h2>
			<form id="eval-form" method="POST" action="/evaluate">
				<label for="problem-select">Select Problem</label>
				<select id="problem-select" name="problem_id" onchange="onProblemChange(false)">
					for _, p := range problems {
						<option
							value={ p.ID }
							data-desc={ p.Description }
							data-entrypoint={ p.Entrypoint }
							data-starter={ p.StarterCode }
						>
							{ fmt.Sprintf("%s (%s)", p.Title, p.ID) }
						</option>
					}
				</select>

				<div id="problem-details" style="margin-bottom: 16px; padding: 12px; background: #0d1117; border-radius: 6px; border: 1px solid #30363d; font-size: 0.85rem;">
					<p id="problem-desc" style="color: #8b949e;"></p>
				</div>

				<div style="margin-bottom: 16px; display: flex; flex-wrap: wrap; gap: 8px;">
					<span style="font-size: 0.85rem; color: #8b949e; align-self: center;">Quick Pre-fills:</span>
					<button type="button" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 8px;" onclick="resetToStarter()">Reset Template</button>
					<button type="button" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 8px;" onclick="prefillValid()">Valid Hashmap</button>
					<button type="button" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 8px;" onclick="prefillIrrelevant()">Irrelevant Hashmap</button>
					<button type="button" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 8px;" onclick="prefillMismatch()">Mismatch Claim</button>
					<button type="button" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 8px;" onclick="prefillUserCase()">User TwoSum Input</button>
				</div>

				<label for="explanation">Candidate Explanation of Intended Approach</label>
				<textarea
					id="explanation"
					name="explanation"
					rows="3"
					placeholder="Describe your algorithm and data structures, e.g. I will use a hashmap to store seen elements and lookup complements in O(1)..."
					required
				></textarea>

				<label for="source_code">Candidate Source Code (Python)</label>
				<textarea
					id="source_code"
					name="source_code"
					class="code-editor"
					rows="14"
					placeholder="def solve(...):&#10;    # Write your solution here"
					required
				></textarea>

				<div style="display: flex; justify-content: flex-end;">
					<button type="submit" class="btn" style="padding: 10px 24px; font-size: 1rem;">
						Evaluate Approach Fidelity
					</button>
				</div>
			</form>
		</div>

		<script>
			let lastStarterCode = "";

			function onProblemChange(forceReset) {
				const sel = document.getElementById("problem-select");
				if (!sel || sel.options.length === 0) return;
				const opt = sel.options[sel.selectedIndex];
				document.getElementById("problem-desc").innerText = opt.getAttribute("data-desc") || "";

				const starter = opt.getAttribute("data-starter") || "";
				const codeArea = document.getElementById("source_code");

				if (forceReset || codeArea.value.trim() === "" || codeArea.value.trim() === lastStarterCode.trim()) {
					codeArea.value = starter;
				}
				lastStarterCode = starter;
			}

			function resetToStarter() {
				onProblemChange(true);
			}

			function prefillValid() {
				document.getElementById("explanation").value = "I'll store each number and its index in a hashmap, and then look up whether the target complement exists in constant time.";
				document.getElementById("source_code").value = "def solve(nums, target):\n    seen = {}\n    for i, n in enumerate(nums):\n        diff = target - n\n        if diff in seen:\n            return [seen[diff], i]\n        seen[n] = i\n    return []";
			}

			function prefillIrrelevant() {
				document.getElementById("explanation").value = "I will use two pointers and a hashmap to check frequencies.";
				document.getElementById("source_code").value = "def solve(nums, target):\n    counts = {}\n    for x in nums:\n        counts[x] = counts.get(x, 0) + 1\n    # Hashmap above does not contribute to two pointers result below\n    left = 0\n    right = len(nums) - 1\n    while left < right:\n        s = nums[left] + nums[right]\n        if s == target:\n            return [left, right]\n        elif s < target:\n            left += 1\n        else:\n            right -= 1\n    return [0, 1]";
			}

			function prefillMismatch() {
				document.getElementById("explanation").value = "I will use binary search to locate pairs in the array.";
				document.getElementById("source_code").value = "def solve(nums, target):\n    seen = {}\n    for i, n in enumerate(nums):\n        diff = target - n\n        if diff in seen:\n            return [seen[diff], i]\n        seen[n] = i\n    return []";
			}

			function prefillUserCase() {
				document.getElementById("explanation").value = "So I will iterate through the array, keep a Hashmap storing their index, match target - current number, check for this value in hte Hashmap, if found return these two index the current and the one stored in Hashmap else return empty array for not found.";
				document.getElementById("source_code").value = "nums = [2, 7, 11, 15]\ntarget = 9\n\nprint(twoSum(nums, target))  # [0, 1]\n\ndef twoSum(nums, target):\n    seen = {}\n\n    for i, num in enumerate(nums):\n        complement = target - num\n\n        if complement in seen:\n            return [seen[complement], i]\n\n        seen[num] = i\n\n    return []";
			}

			// Initialize on load
			window.addEventListener("DOMContentLoaded", function() {
				onProblemChange(false);
			});
		</script>
	}
}
